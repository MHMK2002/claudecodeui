{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "source": "src/index.css and tailwind.config.js",
  "color": {
    "light": {
      "background": { "$type": "color", "$value": "hsl(44 22% 96%)" },
      "foreground": { "$type": "color", "$value": "hsl(36 25% 4%)" },
      "card": { "$type": "color", "$value": "hsl(0 0% 100%)" },
      "cardForeground": { "$type": "color", "$value": "hsl(36 25% 4%)" },
      "popover": { "$type": "color", "$value": "hsl(0 0% 100%)" },
      "popoverForeground": { "$type": "color", "$value": "hsl(36 25% 4%)" },
      "primary": { "$type": "color", "$value": "hsl(221.2 83.2% 53.3%)" },
      "primaryForeground": { "$type": "color", "$value": "hsl(210 40% 98%)" },
      "messageUser": { "$type": "color", "$value": "hsl(221.2 83.2% 53.3%)" },
      "messageUserForeground": { "$type": "color", "$value": "hsl(210 40% 98%)" },
      "secondary": { "$type": "color", "$value": "hsl(44 15% 91%)" },
      "secondaryForeground": { "$type": "color", "$value": "hsl(36 15% 18%)" },
      "muted": { "$type": "color", "$value": "hsl(44 15% 91%)" },
      "mutedForeground": { "$type": "color", "$value": "hsl(40 5% 40%)" },
      "accent": { "$type": "color", "$value": "hsl(44 15% 91%)" },
      "accentForeground": { "$type": "color", "$value": "hsl(36 15% 18%)" },
      "destructive": { "$type": "color", "$value": "hsl(0 72% 42%)" },
      "destructiveForeground": { "$type": "color", "$value": "hsl(210 40% 98%)" },
      "border": { "$type": "color", "$value": "hsl(44 14% 87%)" },
      "input": { "$type": "color", "$value": "hsl(44 14% 87%)" },
      "ring": { "$type": "color", "$value": "hsl(221.2 83.2% 53.3%)" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "hsl(0 0% 8%)" },
      "foreground": { "$type": "color", "$value": "hsl(40 8% 93%)" },
      "card": { "$type": "color", "$value": "hsl(0 0% 12%)" },
      "cardForeground": { "$type": "color", "$value": "hsl(40 8% 93%)" },
      "popover": { "$type": "color", "$value": "hsl(0 0% 12%)" },
      "popoverForeground": { "$type": "color", "$value": "hsl(40 8% 93%)" },
      "primary": { "$type": "color", "$value": "hsl(217.2 91.2% 59.8%)" },
      "primaryForeground": { "$type": "color", "$value": "hsl(0 0% 8%)" },
      "messageUser": { "$type": "color", "$value": "hsl(224 76% 48%)" },
      "messageUserForeground": { "$type": "color", "$value": "hsl(210 40% 98%)" },
      "secondary": { "$type": "color", "$value": "hsl(0 0% 17%)" },
      "secondaryForeground": { "$type": "color", "$value": "hsl(40 8% 93%)" },
      "muted": { "$type": "color", "$value": "hsl(0 0% 17%)" },
      "mutedForeground": { "$type": "color", "$value": "hsl(0 0% 60%)" },
      "accent": { "$type": "color", "$value": "hsl(0 0% 17%)" },
      "accentForeground": { "$type": "color", "$value": "hsl(40 8% 93%)" },
      "destructive": { "$type": "color", "$value": "hsl(0 72% 65%)" },
      "destructiveForeground": { "$type": "color", "$value": "hsl(0 0% 8%)" },
      "border": { "$type": "color", "$value": "hsl(0 0% 17%)" },
      "input": { "$type": "color", "$value": "hsl(0 0% 23%)" },
      "ring": { "$type": "color", "$value": "hsl(217.2 91.2% 59.8%)" }
    }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": "4px" },
    "medium": { "$type": "dimension", "$value": "6px" },
    "large": { "$type": "dimension", "$value": "8px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Encode Sans", "Vazirmatn", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
    "serif": { "$type": "fontFamily", "$value": ["Merriweather", "Vazirmatn", "Georgia", "Cambria", "Times New Roman", "serif"] }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "100ms" },
    "normal": { "$type": "duration", "$value": "150ms" },
    "slow": { "$type": "duration", "$value": "200ms" },
    "drawer": { "$type": "duration", "$value": "300ms" }
  },
  "interaction": {
    "minimumTarget": { "$type": "dimension", "$value": "44px" },
    "focusWidth": { "$type": "dimension", "$value": "2px" },
    "focusOffset": { "$type": "dimension", "$value": "2px" }
  },
  "layout": {
    "desktopContainerMax": { "$type": "dimension", "$value": "1400px" },
    "mobileSmokeWidth": { "$type": "dimension", "$value": "320px" },
    "mobileNavigationHeight": { "$type": "dimension", "$value": "52px" },
    "mobileNavigationPadding": { "$type": "dimension", "$value": "20px" }
  }
}
